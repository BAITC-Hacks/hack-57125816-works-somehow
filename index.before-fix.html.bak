<!doctype html>

<!--
  ІРІКТЕУ — БІР ФАЙЛДЫҚ ТОЛЫҚ ВЕБ-ҚОСЫМША

  Өңдеу: VS Code → File → Open File… → осы index.html файлын таңдаңыз.
  Іске қосу: файлды Safari немесе Chrome браузерінде ашыңыз.
  Live Server, Terminal, Python, npm, интернет және Серверсіз жұмыс істейді.

  Бөлімдер:
  1. Көрініс (CSS) — <style> ішінде.
  2. Қазақша интерфейс (HTML) — <body>
  <!-- 2. ҚАЗАҚША ИНТЕРФЕЙС: HTML --> ішінде.
  3. Нақты CSV деректері және түсіндірме дәлелдері — catalog-data блогында.
  4. Іріктеу мен карточкаларды көрсету (JavaScript) — соңғы <script> ішінде.

  66 профиль бастапқы CSV-ден өзгеріссіз түрлендірілген көшірме ретінде енгізілді.
  CSV кейін өзгерсе, осы файлдағы дерек көшірмесін бөлек жаңарту керек.
  Реттілік: бастапқы баға өсуімен, тең болса id өсуімен; ең көбі 3 карточка.
  max_hours=null — ұзақтық қолданылмайды; busy_dates күндері ұсынылмайды.
  AI қолданылмайды. Жеке кілттер жоқ. Барлық есеп браузер ішінде орындалады.
-->

<html lang="kk">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Іс-шараға маман немесе орын таңдаңыз. Нақты каталог, түсінікті себептер, ең көбі үш сәйкес профиль.">
  <title>Іріктеу — іс-шараңызға лайық профильдер</title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%232645ed'/%3E%3Cpath d='m9 16 5 5 9-11' fill='none' stroke='white' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
  <!-- 1. КӨРІНІС: CSS -->
  <style>
:root {
  --ink:#172236;
  --muted:#5b6578;
  --blue:#2948df;
  --line:#e0e5ee;
  --paper:#fff;
  --bg:#f4f6fa;
  --soft:#edf1ff;
  --amber:#815616;
  --green:#176343;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  color:var(--ink);
  background:var(--bg);
  font-size:16px;
  font-synthesis:none;
}
* {
  box-sizing:border-box;
}
body {
  margin:0;
}
button,input,select {
  font:inherit;
}
button,a,input,select {
  -webkit-tap-highlight-color:transparent;
}
button {
  cursor:pointer;
}
a {
  color:inherit;
}
button:disabled {
  cursor:wait;
  opacity:.6;
}
[hidden] {
  display:none!important;
}
:focus-visible {
  outline:3px solid #6783ff;
  outline-offset:3px;
}
.topbar {
  min-height:86px;
  padding:18px max(32px,calc((100vw - 1300px)/2));
  display:flex;
  align-items:center;
  gap:40px;
  background:#fff;
  border-bottom:1px solid var(--line);
}
.brand {
  display:flex;
  align-items:center;
  gap:9px;
  text-decoration:none;
  font-size:27px;
  font-weight:750;
  letter-spacing:-1px;
}
.brand-mark {
  display:grid;
  place-items:center;
  border-radius:10px;
  background:var(--blue);
  color:white;
  width:35px;
  height:35px;
  font-size:28px;
  font-weight:650;
  letter-spacing:0;
}
.brand-dot {
  margin-left:-9px;
  color:var(--blue);
}
.header-note {
  font-size:14px;
  color:var(--muted);
}
.divider {
  margin:0 12px;
  color:#a8b0c1;
}
.mode {
  margin-left:auto;
  padding:8px 11px;
  border:1px solid var(--line);
  border-radius:6px;
  color:var(--muted);
  font-size:13px;
}
.workspace {
  max-width:1364px;
  margin:0 auto;
  padding:40px 32px 0;
}
.intro {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:24px;
  margin-bottom:32px;
}
.eyebrow {
  font-size:12px;
  font-weight:750;
  letter-spacing:1.7px;
  color:var(--blue);
  margin:0 0 11px;
}
h1 {
  font-size:clamp(27px,3vw,38px);
  letter-spacing:-1.15px;
  line-height:1.2;
  margin:0 0 12px;
  font-weight:730;
}
.intro-copy {
  color:var(--muted);
  margin:0;
  line-height:1.55;
}
.catalog-stat {
  display:flex;
  align-items:center;
  gap:14px;
  padding-left:30px;
  border-left:1px solid #d3dbea;
  flex-shrink:0;
}
.catalog-stat strong {
  font-size:48px;
  font-weight:500;
  letter-spacing:-2px;
}
.catalog-stat span {
  color:var(--muted);
  font-size:13px;
  line-height:1.5;
}
.layout {
  display:grid;
  grid-template-columns:340px minmax(0,1fr);
  gap:28px;
  align-items:start;
}
.search-panel {
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:12px;
  padding:24px;
  box-shadow:0 3px 12px #18275604;
}
.panel-heading {
  display:flex;
  gap:10px;
  align-items:center;
}
.panel-heading h2 {
  font-size:17px;
  margin:0;
  font-weight:680;
}
.section-number {
  font-size:12px;
  font-variant-numeric:tabular-nums;
  font-weight:650;
  color:var(--blue);
  background:var(--soft);
  border-radius:5px;
  padding:5px 6px;
}
.search-panel .panel-heading {
  margin-bottom:24px;
}
fieldset {
  border:0;
  padding:0;
  margin:0;
  min-width:0;
}
label {
  display:block;
  font-size:14px;
  font-weight:580;
  margin:18px 0 8px;
}
fieldset>label:first-child {
  margin-top:0;
}
input,select {
  width:100%;
  height:45px;
  background:#fff;
  color:var(--ink);
  border:1px solid #ccd3df;
  border-radius:6px;
  padding:10px 12px;
  min-width:0;
  transition:border-color .15s;
}
select {
  padding-right:24px;
}
input:hover,select:hover {
  border-color:#8996b0;
}
input:focus,select:focus {
  border-color:var(--blue);
}
input::placeholder {
  color:#737d91;
}
.field-help {
  font-size:12px;
  line-height:1.5;
  color:var(--muted);
  margin:7px 0 0;
}
.optional-heading {
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-weight:650;
  font-size:14px;
  margin:24px 0 0;
  padding-top:22px;
  border-top:1px solid var(--line);
  gap:6px;
}
.optional-heading span {
  font-size:12px;
  font-weight:400;
  color:var(--muted);
}
.optional-grid {
  display:grid;
  grid-template-columns:1.15fr 1fr;
  gap:12px;
}
.optional-grid label {
  font-size:13px;
}
.optional-grid select,.optional-grid input {
  font-size:14px;
  padding-left:8px;
}
.search-button {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
  background:var(--blue);
  color:#fff;
  font-size:14px;
  font-weight:600;
  border:0;
  border-radius:7px;
  padding:16px 13px;
  width:100%;
  margin-top:23px;
  transition:background .15s;
}
.search-button:hover {
  background:#1834c4;
}
.search-button span {
  font-size:21px;
  line-height:1;
}
.examples {
  margin-top:24px;
  padding-top:19px;
  border-top:1px solid var(--line);
}
.examples p {
  font-size:12px;
  color:var(--muted);
  margin:0 0 10px;
}
.example-buttons {
  display:flex;
  gap:6px;
  flex-wrap:wrap;
}
.example-buttons button {
  background:#fff;
  border:1px solid var(--line);
  color:var(--muted);
  font-size:12px;
  border-radius:5px;
  padding:8px;
}
.example-buttons button:hover {
  color:var(--blue);
  border-color:var(--blue);
}
.results-heading {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin:8px 0 21px;
}
.sort-note {
  font-size:12px;
  color:var(--muted);
}
.sort-note span {
  margin:0 4px;
}
.result-summary {
  margin-bottom:20px;
}
.status-line {
  display:flex;
  align-items:center;
  gap:9px;
  margin-bottom:9px;
}
.status-badge {
  font-size:12px;
  background:#e4f2ea;
  color:var(--green);
  padding:4px 7px;
  border-radius:4px;
  font-weight:650;
  white-space:nowrap;
}
.status-line h3 {
  font-size:19px;
  margin:0;
  line-height:1.4;
}
.summary-text {
  color:var(--muted);
  font-size:14px;
  line-height:1.6;
  margin:0;
}
.query-tags {
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin-top:12px;
}
.query-tag {
  border:1px solid #dce2ee;
  border-radius:5px;
  padding:5px 8px;
  font-size:12px;
  color:#4b566c;
  background:#fafbfe;
}
.cards {
  display:grid;
  gap:14px;
}
.profile-card {
  position:relative;
  padding:22px 24px;
  background:white;
  border:1px solid var(--line);
  border-radius:10px;
  box-shadow:0 2px 7px #18275603;
}
.profile-card:first-child {
  border-left:3px solid var(--blue);
  padding-left:22px;
}
.card-top {
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:18px;
}
.profile-identity {
  display:flex;
  align-items:flex-start;
  gap:13px;
  min-width:0;
}
.rank {
  color:var(--blue);
  font-size:14px;
  font-weight:650;
  background:var(--soft);
  min-width:36px;
  height:36px;
  border-radius:7px;
  display:grid;
  place-items:center;
  font-variant-numeric:tabular-nums;
}
.profile-card h3 {
  font-size:19px;
  margin:0 0 6px;
  line-height:1.35;
  font-weight:650;
}
.profile-meta {
  font-size:13px;
  line-height:1.5;
  color:var(--muted);
  margin:0;
}
.price {
  font-size:16px;
  line-height:1.5;
  text-align:right;
  font-weight:650;
  max-width:200px;
  margin:0;
  flex-shrink:0;
}
.price small {
  display:block;
  font-size:12px;
  color:var(--muted);
  font-weight:400;
}
.explanation {
  line-height:1.65;
  font-size:14px;
  color:#35425a;
  margin:19px 0 16px;
  padding-left:13px;
  border-left:2px solid #e0e6f9;
}
.card-attributes {
  display:flex;
  flex-wrap:wrap;
  gap:8px 16px;
  font-size:12px;
  color:var(--muted);
  margin-bottom:14px;
}
.flag-row {
  display:flex;
  gap:6px;
  flex-wrap:wrap;
  padding-top:13px;
  border-top:1px solid #edf0f5;
}
.flag {
  font-size:12px;
  padding:4px 7px;
  border:1px solid #e3e7ee;
  border-radius:4px;
  color:#616b7c;
  background:#fbfcfe;
}
.flag.active {
  background:#fff7e7;
  border-color:#f0d7a7;
  color:#795012;
}
.evidence {
  margin-top:12px;
  font-size:12px;
  color:var(--muted);
}
summary {
  cursor:pointer;
  line-height:1.55;
}
summary:hover {
  color:var(--blue);
}
blockquote {
  margin:10px 0 0;
  border-left:2px solid #d7dfee;
  padding-left:12px;
  line-height:1.65;
  white-space:pre-line;
  overflow-wrap:anywhere;
}
.diagnostics {
  margin-top:18px;
  border:1px solid #dce2ed;
  border-radius:9px;
  padding:18px 20px;
  background:#f0f3f9;
}
.diagnostics h4 {
  font-size:14px;
  margin:0 0 12px;
}
.reason-list {
  list-style:none;
  margin:0;
  padding:0;
  display:flex;
  flex-wrap:wrap;
  gap:8px;
}
.reason-list li {
  font-size:12px;
  padding:7px 9px;
  border:1px solid #dce2ed;
  background:white;
  border-radius:5px;
}
.reason-list strong {
  margin-left:7px;
  color:var(--blue);
}
.diagnostic-note {
  font-size:12px;
  color:var(--muted);
  line-height:1.55;
  margin:12px 0 0;
}
.rejections {
  font-size:13px;
  margin-top:12px;
}
.rejections ul {
  padding-left:18px;
  line-height:1.7;
}
.rejections li {
  margin-top:8px;
}
.rejection-id {
  font-size:12px;
  color:var(--muted);
}
.empty-state {
  min-height:250px;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:flex-start;
  background:white;
  padding:32px;
  border:1px solid var(--line);
  border-radius:10px;
}
.empty-state .empty-icon {
  color:var(--amber);
  background:#fff4df;
  padding:9px 12px;
  border-radius:8px;
  font-size:20px;
  margin-bottom:14px;
}
.empty-state h3 {
  margin:0 0 12px;
  font-size:22px;
  line-height:1.4;
}
.empty-state p {
  margin:0;
  line-height:1.7;
  color:var(--muted);
  font-size:15px;
}
.data-note {
  display:flex;
  align-items:flex-start;
  gap:10px;
  color:var(--muted);
  font-size:12px;
  line-height:1.7;
  margin:20px 2px;
}
.data-note p {
  margin:0;
}
.note-icon {
  border:1px solid #9ca9bf;
  border-radius:50%;
  width:17px;
  height:17px;
  display:grid;
  place-items:center;
  font-size:11px;
  flex-shrink:0;
  margin-top:2px;
}
.transparency {
  margin-top:36px;
  border-top:1px solid #dce2ec;
  padding:26px 0 22px;
}
.transparency h2 {
  font-size:14px;
  margin:0 0 18px;
}
.flag-legend {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:25px;
}
.flag-legend p {
  display:flex;
  flex-direction:column;
  gap:8px;
  margin:0;
}
.flag-legend code {
  font-size:12px;
  color:#495a77;
}
.flag-legend span {
  font-size:13px;
  line-height:1.6;
  color:var(--muted);
}
.legend-summary {
  font-size:12px;
  color:var(--muted);
  margin:18px 0 0;
}
footer {
  max-width:1364px;
  padding:20px 32px 28px;
  margin:0 auto;
  border-top:1px solid var(--line);
  display:flex;
  justify-content:space-between;
  gap:20px;
  color:var(--muted);
  font-size:12px;
}
.form-error {
  padding:12px;
  background:#fff0f0;
  border:1px solid #f0c5c5;
  border-radius:6px;
  color:#982929;
  font-size:14px;
  line-height:1.5;
}
.retry-button {
  margin-top:18px;
  background:var(--blue);
  color:white;
  border:0;
  border-radius:6px;
  padding:11px 16px;
}
.dirty-state {
  min-height:200px;
}
.empty-state:focus {
  outline:none;
}
@media(min-width:1450px) {
  .workspace {
    padding-top:46px;
  }
}
@media(max-width:1050px) {
  .layout {
    grid-template-columns:310px minmax(0,1fr);
    gap:20px;
  }
  .search-panel {
    padding:20px;
  }
  .card-top {
    flex-direction:column;
    gap:12px;
  }
  .price {
    text-align:left;
    max-width:none;
    margin-left:49px;
  }
  .price small {
    display:inline;
    margin-left:6px;
  }
  .sort-note {
    max-width:105px;
    line-height:1.5;
    text-align:right;
  }
  .header-note {
    display:none;
  }
  .profile-card {
    padding:20px;
  }
  .profile-card:first-child {
    padding-left:18px;
  }
}
@media(max-width:740px) {
  .topbar {
    padding:16px 20px;
    min-height:73px;
    gap:10px;
  }
  .mode {
    font-size:12px;
    padding:6px 8px;
  }
  .workspace {
    padding:28px 18px 0;
  }
  .intro {
    margin-bottom:26px;
  }
  .catalog-stat {
    display:none;
  }
  h1 {
    font-size:29px;
    letter-spacing:-.7px;
  }
  .intro-copy {
    font-size:15px;
  }
  .layout {
    grid-template-columns:1fr;
    gap:28px;
  }
  .search-panel {
    padding:22px;
  }
  .results-heading {
    margin-top:0;
  }
  .card-top {
    flex-direction:row;
  }
  .price {
    text-align:right;
    margin-left:0;
    max-width:145px;
    font-size:14px;
  }
  .price small {
    display:block;
    margin-left:0;
  }
  .profile-card h3 {
    font-size:17px;
  }
  .profile-identity {
    gap:10px;
  }
  .rank {
    min-width:29px;
    height:29px;
    font-size:12px;
  }
  .flag-legend {
    grid-template-columns:1fr;
    gap:18px;
  }
  .flag-legend p {
    gap:4px;
  }
  .transparency {
    margin-top:28px;
  }
  .status-line {
    align-items:flex-start;
  }
  .status-line h3 {
    font-size:17px;
  }
  .status-badge {
    margin-top:2px;
  }
  footer {
    padding:20px 18px;
    flex-direction:column;
    gap:10px;
  }
}
@media(max-width:420px) {
  .card-top {
    flex-direction:column;
  }
  .price {
    text-align:left;
    margin-left:39px;
    max-width:none;
  }
  .price small {
    display:inline;
    margin-left:5px;
  }
  .profile-card {
    padding:18px;
  }
  .profile-card:first-child {
    padding-left:16px;
  }
  .sort-note {
    font-size:12px;
    max-width:90px;
  }
  .panel-heading h2 {
    font-size:16px;
  }
  .mode {
    max-width:123px;
    text-align:center;
  }
  .explanation {
    font-size:14px;
  }
  .flag {
    font-size:12px;
  }
}
@media(prefers-reduced-motion:reduce) {
  * {
    transition:none!important;
    scroll-behavior:auto!important;
  }
}
  </style>
</head>
<body>
  <header class="topbar">
    <a class="brand" href="#" aria-label="Іріктеу — басты бет"><span class="brand-mark" aria-hidden="true">і</span> іріктеу<span class="brand-dot">.</span></a>
    <span class="header-note">HackAlem <span class="divider">/</span> Іс-шара каталогы</span>
    <span class="mode">Серверсіз жұмыс істейді</span>
  </header>
  <main class="workspace">
    <section class="intro" aria-labelledby="page-title">
      <div><p class="eyebrow">ДӘЛЕЛГЕ СҮЙЕНГЕН ТАҢДАУ</p><h1 id="page-title">Іс-шараңызға кім керек?</h1><p class="intro-copy">Шарттарыңызды көрсетіңіз. Каталогтан ең көбі 3 сәйкес профиль табамыз.</p></div>
      <div class="catalog-stat"><strong id="catalog-total">—</strong><span>профиль<br>бір каталогта</span></div>
    </section>
    <div class="layout">
      <aside class="search-panel">
        <div class="panel-heading"><span class="section-number">01</span><h2>Іс-шара шарттары</h2></div>
        <form id="search-form">
          <fieldset id="fields" disabled>
